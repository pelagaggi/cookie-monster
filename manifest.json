{
  "manifest_version": 3,
  "name": "Cookie Monster",
  "version": "1.0.0",
  "description": "When a cookie banner shows up, a hungry blue monster eats the accept button for you.",
  "permissions": ["storage", "tts", "offscreen"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Cookie Monster",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "run_at": "document_idle",
      "all_frames": false,
      "js": [
        "content/matching.js",
        "content/detector.js",
        "content/character.js",
        "content/monster.js",
        "content/main.js"
      ]
    }
  ]
}
